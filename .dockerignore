# Applies to `docker build -f backend/Dockerfile .` (repo-root context --
# needed because the image also pulls in data/, a sibling of backend/). Keeps
# the build context small and keeps local secrets/dev artifacts and the
# ~900MB frontend/ tree out of what gets sent to the Docker daemon.

# Not needed to build or run the backend image at all.
frontend/
docs/
.git/
.github/
.claude/
.idea/
README.md
LICENSE
CLAUDE.md
DEPLOYMENT-CHECKLIST.md

# backend/ dev-only artifacts.
backend/.venv/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/tests/
backend/CLAUDE.md

# Local dev DB -- the real one is a mounted volume at container run time,
# never part of the image (see DEPLOYMENT-CHECKLIST.md).
backend/database/kira.db

backend/.env
backend/.env.*
!backend/.env.example

__pycache__/
